{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mpthree-dl",
  "version": "0.1.0",
  "identifier": "dev.mpthree.dl",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mpthree-dl",
        "width": 1100,
        "height": 740,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
